# Local PostgreSQL / pgvector instance
POSTGRES_DB=servicerswitch
POSTGRES_USER=servicerswitch
POSTGRES_PASSWORD=servicerswitch
DATABASE_URL=postgresql+psycopg://servicerswitch:servicerswitch@postgres:5432/servicerswitch
ENGINE_API_BASE=http://engine:8080

# Reserved for the model-backed extraction work introduced in C8.
# Keep the real value only in .env; tests use a fake client.
LLM_API_KEY=
LLM_MODEL=
LLM_API_BASE=https://api.openai.com/v1

# C9 retrieval embeddings. EMBEDDING_API_KEY may be omitted to reuse LLM_API_KEY.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=512
EMBEDDING_API_BASE=https://api.openai.com/v1
